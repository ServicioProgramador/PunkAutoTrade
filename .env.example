# Archivo de ejemplo: copiar a .env local y completar. NO subir ni compartir el .env
PA_TG_API_ID=
PA_TG_API_HASH=
PA_TG_SESSION=data/punk_telegram
# ID numerico negativo autorizado, obtenido con --telegram-channels
PA_CHANNELS=
# API key de Bitunix Futures. Para LIVE necesita permiso de trading; nunca permiso de retiro.
PA_BITUNIX_API_KEY=
PA_BITUNIX_API_SECRET=
# Opcional: cotizacion fija del simulador PAPER, NO es precio real
PA_PAPER_PRICE=66000
# Opcional F56: base de datos LIVE (por defecto data/punk_live.db)
# PA_LIVE_DB_PATH=data/punk_live.db
# Opcional F56: comision taker usada para reserva y Break Even (por defecto 0.0006)
# PA_LIVE_FEE_RATE=0.0006
# Opcional F60: avisos a tu Telegram personal mediante TU bot (@BotFather)
# PA_NOTIFY_BOT_TOKEN=
# PA_NOTIFY_CHAT_ID=
# Opcional F59c: movimiento de precio a favor (%) para mover el SL a Break Even (1 = 20% ROI a 20x)
# PA_LIVE_BE_MOVE_PCT=1
